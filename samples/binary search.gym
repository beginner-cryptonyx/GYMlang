# main code translated from geeksforgeeks

natty binarySearch(arr, x):
    low rack 0
    high rack len(arr) - 1
    circuit low <= high:

        mid rack low + (high - low) // 2

        # Check if x is present at mid
        jacked arr[mid] == x:
            return mid

        # If x is greater, ignore left half
        juiced arr[mid] < x:
            low rack mid + 1

        # If x is smaller, ignore right half
        juiced:
            high rack mid - 1

    # If we reach here, then the element
    # was not present
    failure -1

# werid stuff with the "natty" keyword, natty is the replacement for def defnattyfs like 'natty'
natty fake_print(text): # natty
    """
    jsvb ineaour oai natty rhgr akshviuar nom nom nattyyyy nattynatty
    """
    
    """ nattyyyyyy natty """
    natty real_print(texxxt):
        print(texxxt, " is natty for sure")
    real_print(text)

if __name__ == '__main__':
    arr rack [2, 3, 4, 10, 40]
    x rack 10

    result = binarySearch(arr, x)
    jacked result != -1:
        print("Element is present at index", result)
    rookie:
        print("Element is not present in array")